DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mpua_lead_engine
DB_USER=root
DB_PASSWORD=

# Used only for running the test suite (pytest). Point this at a separate
# database so tests never touch your working data.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=mpua_lead_engine_test
TEST_DB_USER=root
TEST_DB_PASSWORD=

# OpenStreetMap Overpass API (development / validation source only —
# do not run high-volume production traffic against the public endpoint).
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=60

# Website enrichment (MLE-006)
WEBSITE_TIMEOUT=15
WEBSITE_MAX_PAGES=5
WEBSITE_MAX_CONCURRENCY=5
WEBSITE_USER_AGENT=MPUA-Lead-Engine/0.1
WEBSITE_MAX_RESPONSE_BYTES=5000000
